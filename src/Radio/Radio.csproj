<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Radio</AssemblyName>
    <RootNamespace>Radio</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Survival Log\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\AOT.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\FMODUnity.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(Interop)\R3.dll" Private="false" />
    <Reference Include="$(Interop)\ObservableCollections.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="page.js" LogicalName="Radio.page.js" />
  </ItemGroup>

  <!--
    The game's UnityEngine.CoreModule also defines UnmanagedCallersOnlyAttribute, so the .NET one gets a second name,
    dotnet, that FmodOutput.cs uses to pick it.
  -->
  <Target Name="NameDotnetInterop" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'System.Runtime.InteropServices'">
        <Aliases>global,dotnet</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Radio&#10;收音机" />
    <AssemblyMetadata Include="ModManager.Description" Value="Adds a Radio tab to the record player. Search thousands of internet radio stations from around the world, Chinese stations included, paste a stream link, or play the songs in your own music folder. The radio plays instead of the game's music, follows the music volume slider, needs power like a record, and gives the same morale as a record.&#10;为唱片机加入「收音机」标签页。可以搜索全世界成千上万个网络电台（包括中国电台），粘贴直播链接，或播放你自己音乐文件夹里的歌曲。收音机会代替游戏音乐播放，跟随音乐音量滑块，像唱片一样需要电力，也和唱片一样提升心态。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="Audio" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.21671" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Live" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-Radio" />
    <AssemblyMetadata Include="ModManager.NexusId" Value="155" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-Radio/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
